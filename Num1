#include <iostream>
using namespace std;

int main() {
    int number;

    cout << "Enter a number (maximum of 4 digits): ";
    cin >> number;

    if (number <= 0) {
        cout << "It is a non-positive number";
    }
    else if (number < 10) {
        cout << "It is a positive number with 1 digit";
    }
    else if (number < 100) {
        cout << "It is a positive number with 2 digits";
    }
    else if (number < 1000) {
        cout << "It is a positive number with 3 digits";
    }
    else if (number < 10000) {
        cout << "It is a positive number with 4 digits";
    }
    else {
        cout << "Only numbers with a maximum of 4 digits are allowed";
    }

    return 0;
}
